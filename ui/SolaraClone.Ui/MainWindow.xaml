<Window x:Class="SolaraClone.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:av="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="Vesta" Height="720" Width="1180"
        Background="{StaticResource Bg}">
  <DockPanel>

    <Border DockPanel.Dock="Top" Background="{StaticResource BgAlt}"
            BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" Margin="8">
        <Button Content="Attach" Command="{Binding AttachCommand}"/>
        <Button Content="Execute (F5)" Command="{Binding ExecuteCommand}"
                Background="{StaticResource Accent}"/>
        <Button Content="Clear" Command="{Binding ClearCommand}"/>
        <TextBlock Text="{Binding Status}" Foreground="{StaticResource FgDim}"
                   VerticalAlignment="Center" Margin="14,0,0,0"/>
      </StackPanel>
    </Border>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="6"/>
        <RowDefinition Height="220"/>
      </Grid.RowDefinitions>

      <TabControl Grid.Row="0" Background="{StaticResource Bg}"
                  ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}">
        <TabControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Name}"/>
          </DataTemplate>
        </TabControl.ItemTemplate>
        <TabControl.ContentTemplate>
          <DataTemplate>
            <av:TextEditor Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                           FontFamily="Cascadia Mono, Consolas"
                           FontSize="13"
                           Background="{StaticResource Bg}"
                           Foreground="{StaticResource Fg}"
                           ShowLineNumbers="True"
                           SyntaxHighlighting="Luau"
                           x:Name="Editor"/>
          </DataTemplate>
        </TabControl.ContentTemplate>
      </TabControl>

      <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                    Background="{StaticResource Border}"/>

      <DockPanel Grid.Row="2" Background="#0E0E12">
        <TextBlock DockPanel.Dock="Top" Text="CONSOLE" Margin="8,4"
                   Foreground="{StaticResource FgDim}" FontSize="11"/>
        <TextBox Text="{Binding ConsoleText, Mode=OneWay}"
                 IsReadOnly="True" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 Background="#0E0E12" Foreground="{StaticResource Fg}"
                 BorderThickness="0" Padding="8"
                 FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>