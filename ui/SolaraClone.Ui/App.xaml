<Application x:Class="SolaraClone.Ui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg"        Color="#14141A"/>
    <SolidColorBrush x:Key="BgAlt"     Color="#1B1B24"/>
    <SolidColorBrush x:Key="Fg"        Color="#E6E6F0"/>
    <SolidColorBrush x:Key="FgDim"     Color="#8A8AA0"/>
    <SolidColorBrush x:Key="Accent"    Color="#7C5CFF"/>
    <SolidColorBrush x:Key="Accent2"   Color="#3D8BFF"/>
    <SolidColorBrush x:Key="Border"    Color="#2A2A38"/>

    <Style TargetType="Button">
      <Setter Property="Background" Value="{StaticResource BgAlt}"/>
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>
  </Application.Resources>
</Application>